# This repository is intentionally scoped to sync tooling only.
/*
!/.gitignore
!/.gitattributes
!/AGENTS.md
!/CLAUDE.md
!/LICENSE
!/README.md
!/rbx
!/rbx.cmd
!/aftman.toml
!/.nvmrc
!/.github/
!/.github/**
!/tools/
!/tools/**

# Dependency installs
node_modules/
tools/**/node_modules/

# Build output
target/
tools/**/target/
tools/**/target-*/
out/
tools/**/out/
tools/**/out-test/
dist/
coverage/
*.lcov

# Packaged artifacts
*.vsix

# Local/vendor checkouts used as tooling references
_external/
tools/**/_external/

# Runtime/generated output
snapshots/
*.log
*.tmp
.renium/
.renium-cache/
.roblox-sync/
.roblox-sync-cache/
.pi_tmp/
tools/**/.renium/
tools/**/.renium-cache/
tools/**/.renium-daemon.json
tools/**/.vscode-test/

# OS/editor noise
.DS_Store
Thumbs.db
